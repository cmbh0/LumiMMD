<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <!-- MCP 服务（让 AI 客户端通过局域网操作本应用）要监听端口；只有用户在界面里打开开关时才会启动 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      MCP 服务开着时在通知栏挂一个前台服务：AI 客户端和本应用在同一台手机上时，本应用必然在后台，
      没有前台服务的话系统会把进程冻住，客户端要等很久才连得上。只在用户打开 MCP 开关期间存在。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 让用户一键把本应用加进「不限制后台」的名单（部分国产系统即使有前台服务也会冻结后台应用） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!--
      只选了一个 .pmx 时，贴图在它旁边的文件夹里。系统的文件选择器只把选中的那一个文件交给应用，
      要读同一个文件夹里的其它文件得有存储权限。这个权限只在用户点了「允许访问所有文件」之后才会去申请；
      不给也能用（改成让用户选一下文件夹）。
    -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lumi">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="fullUser"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 从文件管理器「打开方式」导入 zip / 模型文件 -->
            <intent-filter android:label="@string/import_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="model/gltf-binary" />
                <data android:mimeType="model/gltf+json" />
                <data android:mimeType="model/obj" />
                <data android:mimeType="model/stl" />
            </intent-filter>
            <intent-filter android:label="@string/import_label">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="model/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>
        <service
            android:name=".core.McpService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local MCP automation server: lets an AI client on this device or the local network operate the app while the user has the MCP switch on." />
        </service>
    </application>
</manifest>
